{
  // Deploys the exported web app as static assets.
  //
  // Without this, `wrangler deploy` runs at the root of the pnpm workspace, finds several
  // packages and refuses: "application detection logic has been run in the root of a
  // workspace instead of targeting a specific project."
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hometuition",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "artifacts/sikshya/web-build",
    // expo-router resolves every route in the browser, so a request for /classroom/123 must
    // still be served index.html. Without this, refreshing a page or opening a shared link
    // returns a 404.
    "not_found_handling": "single-page-application"
  },

  // A second, separate Worker for reviewing a branch before it reaches anybody.
  //
  // Its own name, so its own URL, sharing nothing with production but the build command.
  // Deploying it cannot affect the live site: a different Worker is a different deployment, and
  // `--env preview` never touches the top-level one above.
  //
  // The Worker is only half of a preview. The other half is an API and a database of its own —
  // this file cannot express those, and `PREVIEW.md` explains why they must exist before the
  // "Preview a branch" workflow will run at all.
  "env": {
    "preview": {
      "name": "hometuition-preview",
      "assets": {
        "directory": "artifacts/sikshya/web-build",
        "not_found_handling": "single-page-application"
      }
    }
  }
}
