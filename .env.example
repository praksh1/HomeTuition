# Copy this file to .env at the repo root and fill in the values.
# .env is gitignored; this example file is not.

# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Port the API server listens on.
PORT=8080

NODE_ENV=development

# Public URL used in verification and password-reset emails.
# PUBLIC_APP_URL=https://hometuition.praksh-dhakal.workers.dev

# Transactional email. Both values are required before verification/reset
# messages can be delivered. EMAIL_FROM must use a verified sending domain.
# RESEND_API_KEY=
# BREVO_API_KEY=
# EMAIL_FROM=Sikshya <accounts@example.com>

# Optional social sign-in. A provider remains hidden until all of its required
# values are configured. Public client/app IDs are returned to the app; secrets
# remain server-side. GOOGLE_CLIENT_IDS may contain any additional accepted
# Google audiences as a comma-separated list.
# GOOGLE_WEB_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=
# GOOGLE_CLIENT_IDS=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# APPLE_CLIENT_IDS=

# Optional — video calling only. Everything else works without these.
# DAILY_API_KEY=
# EXPO_PUBLIC_DAILY_DOMAIN=

# Which company carries the audio and video. Daily unless this says otherwise;
# an unrecognised name falls back to Daily rather than taking video down.
# VIDEO_PROVIDER=daily

# Stream Video — an experiment, not production. See STREAM.md. Selecting
# VIDEO_PROVIDER=stream without both of these refuses to open a room and says
# which one is missing. STREAM_API_KEY is the publishable half and is sent to
# the app with the room; STREAM_API_SECRET signs join tokens and must never
# leave the server. STREAM_CALL_TYPE defaults to Stream's own "default" type.
# STREAM_API_KEY=
# STREAM_API_SECRET=
# STREAM_CALL_TYPE=
