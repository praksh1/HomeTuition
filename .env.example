# Copy this file to .env at the repo root and fill in the values.
# .env is gitignored; this example file is not.

# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Port the API server listens on.
PORT=8080

NODE_ENV=development

# Public URL used in verification and password-reset emails.
# PUBLIC_APP_URL=https://hometuition.praksh-dhakal.workers.dev

# Transactional email. Both values are required before verification/reset
# messages can be delivered. EMAIL_FROM must use a verified sending domain.
# RESEND_API_KEY=
# BREVO_API_KEY=
# EMAIL_FROM=Fadko <accounts@example.com>

# Optional social sign-in. A provider remains hidden until all of its required
# values are configured. Public client/app IDs are returned to the app; secrets
# remain server-side. GOOGLE_CLIENT_IDS may contain any additional accepted
# Google audiences as a comma-separated list.
# GOOGLE_WEB_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=
# GOOGLE_CLIENT_IDS=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# APPLE_CLIENT_IDS=

# Optional — video calling only. Everything else works without these.
# DAILY_API_KEY=
# EXPO_PUBLIC_DAILY_DOMAIN=

# Which provider carries the video. Leave unset or "daily" for the live setup.
#
# "livekit" is under trial and runs in the browser only — the Android and iOS
# apps stay on Daily, because both SDKs ship a fork of the same native WebRTC
# library and one phone build cannot contain both.
#
# Setting this to "livekit" is safe with a single deployment: the app tells the
# server what it is, and the server gives a browser LiveKit while a phone keeps
# Daily. Nobody has to remember to leave the phones alone. Switching everything
# back is this variable alone, with no rebuild.
# VIDEO_PROVIDER=daily

# LiveKit Cloud. All three are needed together; with any of them missing the
# provider mints no token rather than half-working. The secret signs tokens on
# the server and is never sent to a browser.
#
# To check them after filling them in: sign in to the support desk and press
# "Check video calls". That reads the deployed server's settings, which is what
# a real class uses. For this file, from the repo root:
#   pnpm run livekit:check
# Either says in words whether each one is present, whether the secret can sign
# a token, and whether LiveKit itself accepts them — and where to fix each.
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=wss://your-project.livekit.cloud
