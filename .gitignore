# Replit
.cache/
.local/

# Generated by `expo prebuild` from app.json and the config plugins. Regenerate rather than
# edit by hand — any manual change here is lost on the next prebuild.
artifacts/sikshya/android/
artifacts/sikshya/ios/

# Local environment — contains the database URL and JWT signing secret. Never commit.
.env
.env.local
*.env
!.env.example

# Production web export
artifacts/sikshya/web-build/
