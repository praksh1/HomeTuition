{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "test:notifications": "node scripts/notification-tests/run.mjs",
    "test:board-limits": "node scripts/board-limits/run.mjs",
    "test:sessions": "node scripts/session-tests/run.mjs",
    "test:payments": "node scripts/payment-tests/run.mjs",
    "test:board-persistence": "node scripts/board-persistence/run.mjs",
    "test:attendance": "node scripts/attendance-tests/run.mjs",
    "test:reviews": "node scripts/review-tests/run.mjs",
    "test:thread": "node scripts/thread-tests/run.mjs",
    "test:admin": "node scripts/admin-tests/run.mjs",
    "test:refunds": "node scripts/refund-tests/run.mjs",
    "test:round": "node scripts/round-tests/run.mjs",
    "test:alerts": "node scripts/alert-tests/run.mjs",
    "test:uploads": "node scripts/upload-tests/run.mjs",
    "test:video": "node scripts/video-tests/run.mjs",
    "test:monthly": "node scripts/monthly-tests/run.mjs",
    "test:portal": "node scripts/portal-tests/run.mjs",
    "test:tickets": "node scripts/ticket-tests/run.mjs",
    "test:upgrade": "node scripts/ticket-upgrade/run.mjs",
    "test:operators": "node scripts/operator-tests/run.mjs",
    "test:one-chat": "node scripts/one-chat/run.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@types/ws": "^8.18.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
