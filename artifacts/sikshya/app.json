{
  "expo": {
    "name": "Sikshya",
    "slug": "sikshya",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "sikshya",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A365D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sikshya.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Sikshya needs microphone access for live classroom audio.",
        "NSCameraUsageDescription": "Sikshya needs camera access for live classroom video.",
        "UIBackgroundModes": ["voip"]
      }
    },
    "android": {
      "package": "com.sikshya.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1A365D"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Sikshya",
      "shortName": "Sikshya"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-screen-orientation",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sikshya needs access to your photos to upload credential documents.",
          "cameraPermission": "Sikshya needs access to your camera to capture credential documents."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Sikshya needs camera access for live classroom video."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow the app to access your camera for video classrooms.",
          "microphonePermission": "Allow the app to access your microphone for audio sessions."
        }
      ],
      "./plugins/withDailyAndroid",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
