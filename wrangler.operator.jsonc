{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fadko-operators",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "artifacts/sikshya/operator-web-build",
    "not_found_handling": "single-page-application"
  },
